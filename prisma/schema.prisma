// Prisma schema para Gestor de Gastos
// DB: PostgreSQL en EC2 (5432 prod / 5433 local via SSM)
// Conexión: ver .env -> DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  income
  expense
}

enum Currency {
  PEN
  USD
  EUR
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  budgets      Budget[]

  @@map("users")
}

model Category {
  id           String          @id @default(cuid())
  name         String
  icon         String          @default("📦")
  color        String          @default("#94A3B8")
  type         TransactionType
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  transactions Transaction[]

  @@unique([name, type])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String
  note        String?
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([type])
  @@index([categoryId])
  @@index([userId])
  @@map("transactions")
}

model Budget {
  id         String   @id @default(cuid())
  categoryId String
  limit      Decimal  @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@map("budgets")
}
